      "parameters": {
        "jsCode": "const response = $json;\n\nconst hasTransportError = !!response.error;\nconst statusCode = response.statusCode ?? (hasTransportError ? 0 : 200);\n\nconst failed =\n  hasTransportError ||\n  statusCode < 200 ||\n  statusCode >= 300;\n\nconst errorMessage = hasTransportError\n  ? (response.error.message ?? response.error.code ?? 'External API request failed')\n  : failed\n    ? `External API returned HTTP ${statusCode}`\n    : null;\n\nreturn [{\n  json: {\n    ...$('Validate Input').first().json,\n    api_status: statusCode,\n    api_failed: failed,\n    result: response.body ?? response,\n    error_type: failed ? 'external_api_failure' : null,\n    error_message: errorMessage,\n    completed_at: new Date().toISOString()\n  }\n}];"
      },
